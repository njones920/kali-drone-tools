[Desktop Entry]
Name=tshark (drone protocols)
Comment=Capture AR.Drone, DJI UAV control, and UAVCAN traffic
Encoding=UTF-8
Exec=bash -c "sudo tshark -Y 'ar_drone || djiuav || uavcan_can || uavcan_dsdl'; exec bash"
Icon=kali-drone-counter-uas
StartupNotify=false
Terminal=true
Type=Application
Categories=kali-drone-rf;kali-drone-counter-uas;kali-drone;
X-Kali-Package=tshark
